# FotoIN Docker Environment Configuration

# Application
APP_ENV=development
APP_SECRET=fotoin-jwt-super-secret-key-change-in-production-2026

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fotoin
DB_SSLMODE=disable

# Cache (Redis)
URL_REDIS=redis://redis:6379/0

# Object Storage (MinIO / S3)
AWS_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_S3_BUCKET=fotoin-bucket
AWS_S3_ENDPOINT=http://minio:9000

# Payment Gateway (Midtrans - Optional for local testing)
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Payment Gateway (Duitku - Alternative)
DUIDKU_ENV=sandbox
DUIDKU_APIKEY=
DUIDKU_MERCHANTCODE=

# SMTP Email (Optional for local testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@fotoin.com
